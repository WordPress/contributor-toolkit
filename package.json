{
  "name": "electron-setup-wordpress-core",
  "author": "Adam Zieliński",
  "version": "0.1.0",
  "private": true,
  "description": "Electron app to setup WordPress develop structure and run npm install",
  "main": "src/main.js",
  "scripts": {
    "start": "concurrently -k \"npm:build:watch\" \"electron .\"",
    "build:watch": "esbuild src/renderer/index.jsx --bundle --outdir=src/renderer --loader:.css=css --platform=browser --format=iife --jsx=automatic --log-level=info --watch",
    "build:once": "esbuild src/renderer/index.jsx --bundle --outdir=src/renderer --loader:.css=css --platform=browser --format=iife --jsx=automatic --log-level=info",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-builder --win --publish never",
    "dist:win:arm64": "electron-builder --win --arm64 --publish never",
    "dist": "electron-builder --publish never",
    "test": "node --test"
  },
  "build": {
    "appId": "org.wordpress.contributor.toolkit",
    "productName": "WordPress Contributor Toolkit",
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.ico",
      "sign": "./scripts/azure-sign.cjs",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "provisioningProfile": ".codesigning/org.wordpress.contributor.toolkit.provisionprofile",
      "notarize": true
    }
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@wordpress/components": "^28.2.0",
    "@wordpress/icons": "^10.7.0",
    "@wp-playground/cli": "^3.0.8",
    "@xterm/xterm": "^5.5.0",
    "diff": "^5.2.0",
    "electron-log": "^5.4.4",
    "electron-store": "^10.0.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "isomorphic-git": "^1.24.4",
    "mailparser": "^3.7.1",
    "npm": "^10.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smtp-server": "^3.14.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^32.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.23.1": true,
    "fs-ext@2.1.1": true
  }
}
